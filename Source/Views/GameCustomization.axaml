<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:colorPicker="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
		x:Class="S6Patcher.Source.Views.GameCustomization"
		Title="S6Patcher"
		SizeToContent="WidthAndHeight"
		Icon="/Resources/favicon.ico"
		Name="wndGameCustomization"
		WindowStartupLocation="CenterScreen"
		CanResize="false">

	<Grid Name="grdMain">
		<HeaderedContentControl Header="Player Customization" Margin="10">
			<Grid RowDefinitions="Auto Auto Auto Auto Auto" ColumnDefinitions="Auto *" Margin="10">
				<CheckBox Grid.Row="0" Grid.ColumnSpan="2" Name="cbPickPlayerColor">Player Color:</CheckBox>
				<colorPicker:ColorPicker Grid.Row="0" Grid.Column="1" Margin="10 5 0 0"
					Name="cpPlayerColor" Color="#1107D8"
					IsEnabled="{Binding #cbPickPlayerColor.IsChecked}" />
				<CheckBox Grid.Row="2" Grid.Column="0" Margin="0 10 0 0" Name="cbSettlerLimit">Settler Limits:</CheckBox>
				<UniformGrid Grid.Row="2" Grid.Column="1" Columns="4" Margin="10 10 0 0"
					IsEnabled="{Binding #cbSettlerLimit.IsChecked}">
					<StackPanel Margin="0 0 5 0">
						<NumericUpDown Name="nudSettlerLimit1" Value="50" Minimum="0" ShowButtonSpinner="False" />
					</StackPanel>
					<StackPanel Margin="0 0 5 0">
						<NumericUpDown Name="nudSettlerLimit2" Value="100" Minimum="0" ShowButtonSpinner="False" />
					</StackPanel>
					<StackPanel Margin="0 0 5 0">
						<NumericUpDown Name="nudSettlerLimit3" Value="150" Minimum="0" ShowButtonSpinner="False" />
					</StackPanel>
					<StackPanel>
						<NumericUpDown Name="nudSettlerLimit4" Value="200" Minimum="0" ShowButtonSpinner="False" />
					</StackPanel>
				</UniformGrid>
				<CheckBox Grid.Row="3" Grid.Column="0" Margin="0 5 0 0" Name="cbSoldierLimit">Soldier Limits:</CheckBox>
				<UniformGrid Grid.Row="3" Grid.Column="1" Columns="4" Margin="10 5 0 0"
					IsEnabled="{Binding #cbSoldierLimit.IsChecked}">
					<StackPanel Margin="0 0 5 0">
						<NumericUpDown Name="nudSoldierLimit1" Value="200" Minimum="0" ShowButtonSpinner="False" />
					</StackPanel>
					<StackPanel Margin="0 0 5 0">
						<NumericUpDown Name="nudSoldierLimit2" Value="200" Minimum="0" ShowButtonSpinner="False" />
					</StackPanel>
					<StackPanel Margin="0 0 5 0">
						<NumericUpDown Name="nudSoldierLimit3" Value="200" Minimum="0" ShowButtonSpinner="False" />
					</StackPanel>
					<StackPanel>
						<NumericUpDown Name="nudSoldierLimit4" Value="200" Minimum="0" ShowButtonSpinner="False" />
					</StackPanel>
				</UniformGrid>
				<StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 15 0 0">
					<Button Name="btnSave" Click="btnSave_Click" Margin="0 0 5 0">Save</Button>
					<Button Name="btnClose" Click="btnClose_Click">Close</Button>
				</StackPanel>
			</Grid>
		</HeaderedContentControl>
	</Grid>
</Window>
